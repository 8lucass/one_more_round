{
  "name": "one-more-round",
  "version": "0.3.0",
  "private": true,
  "description": "One More Round — gallery walk version, phase 3 (TypeScript + Canvas 2D)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --serve",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node scripts/build.mjs && node test/e2e.mjs",
    "test:e2e:standalone": "node scripts/build.mjs && OMR_STANDALONE=1 node test/e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.28.2",
    "playwright": "^1.65.1",
    "typescript": "5.9.3"
  }
}
